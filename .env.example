# Gemini (Google AI Studio). New keys start with AQ.
# Use x-goog-api-key auth; default model is gemini-3.6-flash
GEMINI_API_KEY=
# Optional override
# GEMINI_MODEL=gemini-3.6-flash

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard
ADMIN_PASSWORD=change-me
# Optional extra salt for the admin session cookie (recommended in production)
ADMIN_COOKIE_SECRET=

# Public site URL used when generating table QR codes
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: default cafe id matching supabase/schema.sql seed
NEXT_PUBLIC_CAFE_ID=00000000-0000-0000-0000-000000000001

# POS integration (server only — never expose these to the browser)
POS_INTEGRATION_BASE_URL=https://your-pos-domain.com
POS_INTEGRATION_API_KEY=
POS_WEBHOOK_SECRET=
CRON_SECRET=
MENU_SYNC_MODE=pos
NEXT_PUBLIC_ORDERING_ENABLED=false
# QR /t/5 → POS T05 by default. Only set this if a table_code is not T##:
# TABLE_NUMBER_TO_CODE={"1":"T01","12":"T12"}
# Dev: comma-separated hosts allowed to load /_next from phones on LAN
# ALLOWED_DEV_ORIGINS=192.168.0.3
